# 环境变量与密钥
.env
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
Lib/
Include/
pyvenv.cfg

# 注意：不要写 Scripts/，Windows 上 Git 会把它当成 scripts/ 目录忽略掉，
# 导致项目 scripts/ 下的 Python 脚本无法提交。
# 如果 scripts/ 目录里有虚拟环境残留文件，用下面几行排除：
scripts/*.exe
scripts/activate*
scripts/deactivate.bat
scripts/python*.exe

# Node
frontend/node_modules/
frontend/dist/
npm-debug.log*

# 本地数据与日志
data/*.json
logs/
backups/

# 编辑器
.vscode/settings.json
.idea/
*.swp
